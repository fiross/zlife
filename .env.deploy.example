# FTP Deployment Credentials (Template)
# Copy this file to .env.deploy and fill in your actual details
# NOTE: .env.deploy is git-ignored and must never be committed to public repositories.
FTP_HOST=ftp.yourhosting.com
FTP_USER=your_username
FTP_PASS=your_password
FTP_PORT=21
FTP_REMOTE_DIR=/
SITE_URL=https://your-domain.com
