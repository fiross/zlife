# Apache / Hostinger Shared Hosting Configuration

# Prioritize React HTML index over PHP index
DirectoryIndex index.html index.php

# Prevent directory browsing
Options -Indexes

# Protect sensitive database, config, environment and server files from direct web access
<FilesMatch "^(\.env.*|config\.php|.*\.sql|.*\.sqlite.*|.*\.log|.*\.md|package.*\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Character encoding
AddDefaultCharset UTF-8

# Cache Control: Prevent stale browser caching so users always get fresh updates
<IfModule mod_headers.c>
    # Never cache HTML / HTM files - force browser to fetch latest version
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Ensure CSS and JS files always revalidate against server
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>


# Rewrite Rules for Single Page App & API
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow direct access to physical files (CSS, JS, images, /api/*.php)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Don't rewrite API endpoints
    RewriteCond %{REQUEST_URI} api/ [NC]
    RewriteRule ^ - [L]

    # Route all other URLs to index.html for React SPA client-side routing
    RewriteRule ^ index.html [L]
</IfModule>
